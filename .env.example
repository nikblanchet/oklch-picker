# Copy to .env.local. Everything here ends up in the public bundle.

# Supabase project: Settings > API Keys. Use the publishable (or legacy anon) key.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key-here

# Run `pnpm keygen`. Never put the private key in any file of this project.
VITE_CONTEST_PUBLIC_KEY=
