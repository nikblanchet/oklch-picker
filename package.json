{
  "name": "oklch-picker",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "art": "node art/render.mjs",
    "keygen": "node scripts/keygen.ts",
    "format": "prettier --write .",
    "test:types": "tsc --build",
    "test:js": "oxlint --type-aware --deny-warnings",
    "test:css": "stylelint \"**/*.css\"",
    "test:format": "prettier --check .",
    "test:unit": "node --test \"test/*.test.ts\"",
    "test:e2e": "playwright test && node scripts/check-size.ts",
    "test": "pnpm run --sequential /^test:/"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "colorjs.io": "^0.7.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.9.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
